modules = ["nodejs-20", "web", "postgresql-16"]
run = "bash scripts/bootstrap-node-env.sh && npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "fltk14", "run"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3002

[[ports]]
localPort = 23637
externalPort = 3001

[[ports]]
localPort = 23638
externalPort = 3003

[[ports]]
localPort = 23639
externalPort = 4200

[[ports]]
localPort = 23640
externalPort = 5173

[[ports]]
localPort = 23641
externalPort = 5000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.mjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
## NOTE:
## Do not commit secrets here (UAEPASS_CLIENT_SECRET, API keys, etc).
## Configure these via Replit Secrets / Deployments settings.

[userenv.development]
NODE_ENV = "development"

[userenv.production]
NODE_ENV = "production"

[agent]
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_anthropic_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
