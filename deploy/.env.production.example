# ============================================================
# AgentLabs AI Calling Platform — Production Environment Variables
# ============================================================
# Copy this file to .env in your project root and fill in the values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or are for specific features.
# ============================================================

# ── Core Application ──────────────────────────────────────────
NODE_ENV=production
PORT=5000                                    # Application port (Nginx proxies to this)

# ── Database [REQUIRED] ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agentlabs

# ── Application Domain [REQUIRED] ────────────────────────────
# Your public domain (used for webhook URLs, OAuth redirects, etc.)
APP_DOMAIN=yourdomain.com
# BASE_URL=https://yourdomain.com            # Alternative base URL format
# APP_URL=https://yourdomain.com             # Alternative base URL format

# ── Authentication & Security [REQUIRED] ─────────────────────
JWT_SECRET=your-jwt-secret-change-me-to-a-random-string
JWT_EXPIRY=24h                               # JWT token expiry duration
SESSION_SECRET=your-session-secret-change-me
INTERNAL_API_SECRET=your-internal-api-secret  # For admin API endpoints (X-Internal-API-Key header)
SUPPORT_API_KEY=your-support-api-key          # For public support ticket API (X-API-Key header)

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info                               # debug, info, warn, error

# ── AI Services ──────────────────────────────────────────────
# OpenAI (used for GPT-4o, GPT-4o-mini, TTS, embeddings)
OPENAI_API_KEY=sk-...

# Anthropic Claude (optional — for Claude-based agents)
# ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (for voice synthesis and Conversational AI)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_WEBHOOK_SECRET=your-elevenlabs-webhook-secret

# ── AWS Services (for Bedrock, Polly, S3, Knowledge Bases) ───
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name          # For knowledge base file storage
# AWS_BEDROCK_KB_ROLE_ARN=arn:aws:iam::...   # For Bedrock Knowledge Base

# ── Telephony Providers ──────────────────────────────────────
# Twilio [REQUIRED for calling]
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Plivo (optional — alternative telephony provider)
# PLIVO_AUTH_ID=your-plivo-auth-id
# PLIVO_AUTH_TOKEN=your-plivo-auth-token

# TCXC (optional — alternative telephony provider)
# TCXC_API_KEY=your-tcxc-api-key
# TCXC_API_SECRET=your-tcxc-api-secret

# ── Payment Gateways (configure the ones you use) ────────────
# Stripe
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay (optional)
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PayPal (optional)
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_MODE=live                           # 'sandbox' or 'live'
# PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Paystack (optional)
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...

# MercadoPago (optional)
# MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                            # true for port 465, false for 587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM=your-email@gmail.com

# ── UAE Pass OAuth (optional) ────────────────────────────────
# UAEPASS_CLIENT_ID=your-uaepass-client-id
# UAEPASS_CLIENT_SECRET=your-uaepass-client-secret
# UAEPASS_BASE_URL=https://stg-id.uaepass.ae
# UAEPASS_REDIRECT_URI=https://yourdomain.com/api/auth/uaepass/callback

# ── N8N Workflow Automation (optional) ───────────────────────
# N8N_BASE_URL=https://your-n8n-instance.com
# N8N_API_KEY=your-n8n-api-key

# ── Cartesia Voice (optional) ────────────────────────────────
# CARTESIA_API_KEY=your-cartesia-api-key

# ── Fonoster SIP (optional) ─────────────────────────────────
# FONOSTER_ACCESS_KEY_ID=your-fonoster-key
# FONOSTER_ACCESS_KEY_SECRET=your-fonoster-secret
