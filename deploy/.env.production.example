# ============================================================
# AgentLabs AI Calling Platform — Production Environment Variables
# ============================================================
# Copy this file to .env in your project root and fill in the values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or are for specific features.
# ============================================================

# ── Core Application ──────────────────────────────────────────
NODE_ENV=production
PORT=5000                                    # Application port (Nginx proxies to this)
LOG_LEVEL=info                               # debug, info, warn, error

# ── Database [REQUIRED] ──────────────────────────────────────
DATABASE_URL=postgresql://agentlabs:your-strong-password@localhost:5432/agentlabs
# Docker Compose only: password for the PostgreSQL container
POSTGRES_PASSWORD=your-strong-db-password-here

# ── Application Domain [REQUIRED] ────────────────────────────
# Your public domain (used for webhook URLs, OAuth redirects, telephony callbacks)
APP_DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com
# APP_BASE_URL=https://yourdomain.com        # Alternative base URL format
# BASE_URL=https://yourdomain.com            # Alternative base URL format

# ── Authentication & Security [REQUIRED] ─────────────────────
JWT_SECRET=generate-a-random-64-char-string
JWT_EXPIRY=24h
SESSION_SECRET=generate-another-random-64-char-string
INTERNAL_API_SECRET=generate-a-random-secret-for-admin-api
SUPPORT_API_KEY=generate-a-random-key-for-support-api

# ── OpenAI [REQUIRED for AI features] ────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic Claude (optional) ──────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs [REQUIRED for voice synthesis] ────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_WEBHOOK_SECRET=your-elevenlabs-webhook-hmac-secret

# ── AWS Services (Bedrock, Polly, S3, Knowledge Bases) ───────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_BEDROCK_KB_ROLE_ARN=arn:aws:iam::...

# ── Telephony: Twilio [REQUIRED for calling] ─────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_MODE=live                           # 'live' or 'test'

# ── Telephony: Plivo (optional) ──────────────────────────────
# PLIVO_AUTH_ID=your-plivo-auth-id
# PLIVO_AUTH_TOKEN=your-plivo-auth-token

# ── Telephony: TCXC (optional) ───────────────────────────────
# TCXC_API_KEY=your-tcxc-api-key
# TCXC_API_SECRET=your-tcxc-api-secret

# ── Payment: Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# TESTING_STRIPE_SECRET_KEY=sk_test_...      # For test mode

# ── Payment: Razorpay (optional) ─────────────────────────────
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Payment: PayPal (optional) ───────────────────────────────
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_MODE=live                           # 'sandbox' or 'live'
# PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Payment: Paystack (optional) ─────────────────────────────
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# ── Payment: MercadoPago (optional) ──────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                            # true for port 465, false for 587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM=your-email@gmail.com
# SMTP_FROM_EMAIL=noreply@yourdomain.com     # Override 'from' address

# ── Webhook Secrets (optional) ───────────────────────────────
# FORM_WEBHOOK_SECRET=your-form-webhook-secret
# RAG_WEBHOOK_SECRET=your-rag-webhook-secret
# LOOP9_WEBHOOK_SECRET=your-loop9-webhook-secret

# ── Cartesia Voice (optional) ────────────────────────────────
# CARTESIA_API_KEY=your-cartesia-api-key

# ── N8N Workflow Automation (optional) ───────────────────────
# N8N_BASE_URL=https://your-n8n-instance.com
# N8N_API_KEY=your-n8n-api-key

# ── UAE Pass OAuth (optional) ────────────────────────────────
# UAEPASS_CLIENT_ID=your-uaepass-client-id
# UAEPASS_CLIENT_SECRET=your-uaepass-client-secret
# UAEPASS_BASE_URL=https://stg-id.uaepass.ae
# UAEPASS_REDIRECT_URI=https://yourdomain.com/api/auth/uaepass/callback

# ── Fonoster SIP (optional) ─────────────────────────────────
# FONOSTER_ACCESS_KEY_ID=your-fonoster-key
# FONOSTER_ACCESS_KEY_SECRET=your-fonoster-secret

# ── Feature Toggles (optional) ──────────────────────────────
# USE_RAG_KNOWLEDGE=true                     # Enable RAG knowledge base features

# ── Storage Paths (optional — defaults are fine) ─────────────
# INVOICE_STORAGE_DIR=./data/invoices        # Where generated invoices are stored
