# ============================================================
# AgentLabs AI Calling Platform — Production Environment Variables
# ============================================================
# Copy this file to .env in your project root and fill in the values.
# [REQUIRED] = must be set for the app to start
# [RECOMMENDED] = important for full functionality
# [OPTIONAL] = only needed if you use that specific feature
# ============================================================

# ── Core Application ──────────────────────────────────────────
NODE_ENV=production                          # [REQUIRED]
PORT=5000                                    # [REQUIRED] Application port (Nginx proxies to this)
LOG_LEVEL=info                               # [OPTIONAL] debug, info, warn, error

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://agentlabs:your-strong-password@localhost:5432/agentlabs  # [REQUIRED]
POSTGRES_PASSWORD=your-strong-db-password-here  # [REQUIRED for Docker Compose only]

# ── Application Domain ───────────────────────────────────────
APP_DOMAIN=yourdomain.com                    # [REQUIRED] Used for webhook URLs, telephony callbacks
APP_URL=https://yourdomain.com               # [RECOMMENDED] Full base URL
# APP_BASE_URL=https://yourdomain.com        # [OPTIONAL] Alternative base URL format
# BASE_URL=https://yourdomain.com            # [OPTIONAL] Alternative base URL format

# ── Authentication & Security ────────────────────────────────
JWT_SECRET=generate-a-random-64-char-string  # [REQUIRED]
# JWT_EXPIRY=24h                             # [OPTIONAL] JWT token expiry duration (default: 24h)
SESSION_SECRET=generate-another-random-string # [REQUIRED]
INTERNAL_API_SECRET=generate-a-secret-for-admin-api  # [REQUIRED] X-Internal-API-Key header
SUPPORT_API_KEY=generate-a-key-for-support-api       # [RECOMMENDED] X-API-Key header for support tickets

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                        # [REQUIRED] GPT-4o, TTS, embeddings
# TESTING_STRIPE_SECRET_KEY=sk_test_...      # [OPTIONAL] Stripe test mode key

# Replit AI Integrations (alternative OpenAI/Anthropic keys — optional outside Replit)
# AI_INTEGRATIONS_OPENAI_API_KEY=            # [OPTIONAL] Alternative OpenAI key
# AI_INTEGRATIONS_OPENAI_BASE_URL=           # [OPTIONAL] Custom OpenAI base URL
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=         # [OPTIONAL] Alternative Anthropic key
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=        # [OPTIONAL] Custom Anthropic base URL

# ── ElevenLabs ───────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key   # [REQUIRED] Voice synthesis and Conversational AI
ELEVENLABS_WEBHOOK_SECRET=your-webhook-secret # [RECOMMENDED] HMAC secret for webhook verification
# ELEVENLABS_HMAC_SECRET=                    # [OPTIONAL] Alternative HMAC secret field

# ── AWS Services (Bedrock, Polly, S3, Knowledge Bases) ───────
AWS_ACCESS_KEY_ID=your-aws-access-key        # [RECOMMENDED] Required for Bedrock/Polly/S3
AWS_SECRET_ACCESS_KEY=your-aws-secret-key    # [RECOMMENDED] Required for Bedrock/Polly/S3
AWS_REGION=us-east-1                         # [RECOMMENDED]
# BEDROCK_CLAUDE_MODEL_ID=                   # [OPTIONAL] Override default Claude model for Bedrock
# BEDROCK_KB_S3_BUCKET=                      # [OPTIONAL] S3 bucket for Bedrock Knowledge Base files
# BEDROCK_KB_ROLE_ARN=                       # [OPTIONAL] IAM role ARN for Bedrock Knowledge Base
# BEDROCK_KB_OPENSEARCH_ARN=                 # [OPTIONAL] OpenSearch ARN for Bedrock KB vector store

# ── Telephony: Twilio ────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid   # [REQUIRED] For calling functionality
TWILIO_AUTH_TOKEN=your-twilio-auth-token     # [REQUIRED]
# TWILIO_MODE=live                           # [OPTIONAL] 'live' or 'test'

# ── Telephony: Plivo (optional) ──────────────────────────────
# PLIVO_AUTH_ID=                             # [OPTIONAL] Alternative telephony provider
# PLIVO_AUTH_TOKEN=                          # [OPTIONAL]

# ── Telephony: TCXC (optional) ───────────────────────────────
# TCXC_API_KEY=                              # [OPTIONAL] Alternative telephony provider
# TCXC_API_SECRET=                           # [OPTIONAL]

# ── Payment: Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                # [RECOMMENDED] Payment processing
VITE_STRIPE_PUBLIC_KEY=pk_live_...           # [RECOMMENDED] Client-side Stripe
STRIPE_WEBHOOK_SECRET=whsec_...              # [RECOMMENDED] Stripe webhook verification

# ── Payment: Razorpay (optional) ─────────────────────────────
# RAZORPAY_KEY_ID=rzp_live_...              # [OPTIONAL]
# RAZORPAY_KEY_SECRET=                       # [OPTIONAL]
# RAZORPAY_WEBHOOK_SECRET=                   # [OPTIONAL]

# ── Payment: PayPal (optional) ───────────────────────────────
# PAYPAL_CLIENT_ID=                          # [OPTIONAL]
# PAYPAL_CLIENT_SECRET=                      # [OPTIONAL]
# PAYPAL_MODE=live                           # [OPTIONAL] 'sandbox' or 'live'
# PAYPAL_WEBHOOK_ID=                         # [OPTIONAL]

# ── Payment: Paystack (optional) ─────────────────────────────
# PAYSTACK_SECRET_KEY=sk_live_...            # [OPTIONAL]
# PAYSTACK_PUBLIC_KEY=pk_live_...            # [OPTIONAL]
# PAYSTACK_WEBHOOK_SECRET=                   # [OPTIONAL]

# ── Payment: MercadoPago (optional) ──────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=                  # [OPTIONAL]
# MERCADOPAGO_PUBLIC_KEY=                    # [OPTIONAL]

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com                     # [RECOMMENDED]
SMTP_PORT=587                                # [RECOMMENDED]
# SMTP_SECURE=false                          # [OPTIONAL] true for port 465, false for 587
SMTP_USER=your-email@gmail.com               # [RECOMMENDED]
SMTP_PASS=your-email-password-or-app-password # [RECOMMENDED]
SMTP_FROM=your-email@gmail.com               # [RECOMMENDED] Default from address
# SMTP_FROM_EMAIL=noreply@yourdomain.com     # [OPTIONAL] Override from address

# ── Webhook Secrets ──────────────────────────────────────────
# FORM_WEBHOOK_SECRET=                       # [OPTIONAL] Dynamic form webhook verification
# RAG_WEBHOOK_SECRET=                        # [OPTIONAL] RAG webhook verification
# LOOP9_WEBHOOK_SECRET=                      # [OPTIONAL] OAuth state secret (fallback)
# APPOINTMENT_WEBHOOK_SECRET=                # [OPTIONAL] Appointment booking webhook

# ── Cartesia Voice (optional) ────────────────────────────────
# CARTESIA_API_KEY=                          # [OPTIONAL] Cartesia Sonic voice provider

# ── N8N Workflow Automation (optional) ───────────────────────
# N8N_BASE_URL=https://your-n8n-instance.com # [OPTIONAL]
# N8N_API_KEY=                               # [OPTIONAL]

# ── UAE Pass OAuth (optional) ────────────────────────────────
# UAEPASS_CLIENT_ID=                         # [OPTIONAL]
# UAEPASS_CLIENT_SECRET=                     # [OPTIONAL]
# UAEPASS_BASE_URL=https://stg-id.uaepass.ae # [OPTIONAL]
# UAEPASS_REDIRECT_URI=https://yourdomain.com/api/auth/uaepass/callback  # [OPTIONAL]

# ── Fonoster SIP (optional) ─────────────────────────────────
# FONOSTER_ACCESS_KEY_ID=                    # [OPTIONAL]
# FONOSTER_ACCESS_KEY_SECRET=                # [OPTIONAL]

# ── Feature Toggles ─────────────────────────────────────────
# USE_RAG_KNOWLEDGE=true                     # [OPTIONAL] Enable RAG knowledge base features
# USE_ENHANCED_FLOW_COMPILER=true            # [OPTIONAL] Enable enhanced flow compiler

# ── Storage Paths (defaults are fine for most setups) ────────
# INVOICE_STORAGE_DIR=./data/invoices        # [OPTIONAL] Invoice PDF storage
# REFUND_NOTE_STORAGE_DIR=./data/refund-notes # [OPTIONAL] Refund note storage

# ── Seeding (development/one-time only) ──────────────────────
# RUN_SEED=all                               # [OPTIONAL] Run seed scripts on startup
