[Unit]
Description=AgentLabs AI Calling Platform
Documentation=https://github.com/your-org/agentlabs
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=agentlabs
Group=agentlabs
WorkingDirectory=/home/agentlabs/app
EnvironmentFile=/home/agentlabs/app/.env
ExecStart=/usr/bin/node dist/index.cjs
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentlabs

Environment=NODE_ENV=production

LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
